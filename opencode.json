{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "edit": "allow",
    "bash": {
      "*": "deny",
      "mvn *": "allow",
      "mvn *skipTests*": "deny",
      "mvn *maven.test.skip*": "deny",
      "java tools/CleanCodeReport.java*": "allow",
      "scripts/unabgedeckt.sh*": "allow",
      "./scripts/unabgedeckt.sh*": "allow",
      "bash scripts/unabgedeckt.sh*": "allow",
      "sh scripts/unabgedeckt.sh*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow"
    }
  },
  "agent": {
    "clean-code-coach": {
      "description": "Coacht Schritt für Schritt: erst unter Test bringen, dann umbauen. Ändert nach dem OK des Teilnehmers selbst.",
      "mode": "primary",
      "steps": 40,
      "permission": {
        "question": "allow",
        "edit": {
          "*": "allow",
          "*TripService_Original.java": "deny",
          "pom.xml": "deny",
          ".opencode/*": "deny",
          "AGENTS.md": "deny",
          "opencode.json": "deny"
        }
      }
    }
  }
}
